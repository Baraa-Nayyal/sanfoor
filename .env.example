# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Community invite link sent to users
COMMUNITY_LINK=

# Webhook mode is enabled only when both BASE_URL and WEBHOOK_PATH are set.
# Leave both empty to run with long polling.
BASE_URL=
WEBHOOK_PATH=

# Webhook port (defaults to 8443)
PORT=8443

# Optional secret token verified via the X-Telegram-Bot-Api-Secret-Token header
SECRET_TOKEN=
